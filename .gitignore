# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment files
.env
backend/.env
frontend/.env
.env.local
.env.production.local
.env.*
!.env.example

# Build folders
build/
frontend/build/
backend/frontend/build/

# Local README docs requested outside version tracking
docs/README.md
docs/frontend_README.md

# Uploads / generated media
uploads/
backend/uploads/
storage/
*.mp4
*.mov
*.avi
*.mkv
*.mxf
*.webm

# Logs
*.log
npm-debug.log*

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.qodo/

# Isolated QA runtime, credentials and unsanitized browser artifacts
.qa-runtime/
.qa-private/
qa/test-results/

# Local thesis documents, render caches and scratch work (keep existing tracked files)
/.doc_work/
/deliverables/
/tmp/
__pycache__/

# Keep final QA summaries/inventory, not generated runs, traces or browser artifacts
/analysis/*
!/analysis/qa/
/analysis/qa/*/
!/analysis/qa/inventory/
